<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/titulo_editar_perfil"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNombreCompaneroEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/secondary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/foto_perfil"
            android:textColor="@color/primary" />

        <ImageView
            android:id="@+id/ivFotoEditar"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_foto_perfil"
            android:contentDescription="@string/foto_perfil"
            android:padding="28dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_persona" />

        <Button
            android:id="@+id/btnCambiarFotoEditar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/secondary"
            android:text="@string/cambiar_foto"
            android:textAllCaps="false"
            android:textColor="@color/surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/datos_contacto"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/telefono"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etTelefonoEditar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="phone"
            android:backgroundTint="@color/secondary"
            android:hint="@string/telefono_hint"
            android:inputType="phone"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/correo_electronico"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etCorreoEditar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints="emailAddress"
            android:backgroundTint="@color/secondary"
            android:hint="@string/correo_hint"
            android:inputType="textEmailAddress"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <Button
            android:id="@+id/btnGuardarEditar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="@string/guardar_cambios"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarEditar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/secondary"
            android:text="@string/cancelar"
            android:textAllCaps="false"
            android:textColor="@color/surface" />

    </LinearLayout>

</ScrollView>
