<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".AnadirTareasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/anadir_tarea_titulo"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etNombreTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary"
            android:hint="@string/nombre_tarea_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/prioridad"
            android:textColor="@color/primary" />

        <Spinner
            android:id="@+id/spinnerPrioridadTarea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:popupBackground="@color/background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/companero_anade_tarea"
            android:textColor="@color/primary" />

        <Spinner
            android:id="@+id/spinnerCompaneroTarea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:popupBackground="@color/background" />

        <CheckBox
            android:id="@+id/cbHecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/primary"
            android:text="@string/tarea_hecha"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fecha"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etDiaTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary"
            android:hint="@string/fecha_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hora"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etHoraTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:hint="@string/hora_hint"
            android:importantForAutofill="no"
            android:inputType="none"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dificultad"
            android:textColor="@color/primary" />

        <RatingBar
            android:id="@+id/rbDificultadTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:numStars="5"
            android:progressTint="@color/primary"
            android:rating="3"
            android:stepSize="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dinero_opcional"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etDineroTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary"
            android:hint="@string/dinero_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textColorHint="@color/secondary" />

        <Button
            android:id="@+id/btnAceptarTarea"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/aceptar"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarTarea"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/secondary"
            android:text="@string/cancelar"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
