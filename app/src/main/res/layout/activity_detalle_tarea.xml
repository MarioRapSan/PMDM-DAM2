<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".DetalleTareaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/detalle_tarea"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivFotoDetalle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_foto_tarea"
            android:contentDescription="@string/foto_companero"
            android:padding="24dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_persona" />

        <TextView
            android:id="@+id/tvNombreDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Limpiar cocina" />

        <TextView
            android:id="@+id/tvCompaneroDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/secondary"
            android:textSize="16sp"
            tools:text="Añadida por: Jose" />

        <TextView
            android:id="@+id/tvPrioridadDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="Prioridad: Urgente" />

        <TextView
            android:id="@+id/tvFechaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="Fecha: Lunes · 10:00" />

        <TextView
            android:id="@+id/tvCompartidaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="Tarea compartida por el piso" />

        <TextView
            android:id="@+id/tvDescripcionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="Descripcion: Limpiar la cocina y los fogones." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dificultad"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/rbDificultadDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:isIndicator="true"
            android:numStars="5"
            android:progressTint="@color/primary"
            android:rating="3"
            android:stepSize="1" />

        <!-- Registros de la tarea: entidad relacionada 1-N en Room -->
        <TextView
            android:id="@+id/tvRegistrosDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Registros (1):\n16/11/2026 · 8 puntos · Jose" />

        <Button
            android:id="@+id/btnEditarDetalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/primary"
            android:text="@string/editar"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegistrosDetalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/secondary"
            android:text="@string/ver_registros"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverDetalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/secondary"
            android:text="@string/volver"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
