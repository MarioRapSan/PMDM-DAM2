<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".BuscarActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/buscar_tareas_titulo"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/nombre_buscar"
        android:textColor="@color/primary" />

    <EditText
        android:id="@+id/etBuscarNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/secondary"
        android:hint="@string/nombre_buscar_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/primary"
        android:textColorHint="@color/secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/modo_busqueda"
        android:textColor="@color/primary" />

    <Spinner
        android:id="@+id/spinnerModoBusqueda"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:popupBackground="@color/background" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/prioridad_busqueda"
        android:textColor="@color/primary" />

    <Spinner
        android:id="@+id/spinnerPrioridadBusqueda"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:popupBackground="@color/background" />

    <Button
        android:id="@+id/btnBuscarTareas"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:text="@string/buscar"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvResultadosBusqueda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/border"
            android:dividerHeight="1dp"
            tools:listitem="@layout/item_busqueda_tarea" />

        <TextView
            android:id="@+id/tvSinResultados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/sin_resultados"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnVolverBusqueda"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/secondary"
        android:text="@string/volver"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textStyle="bold" />
</LinearLayout>
