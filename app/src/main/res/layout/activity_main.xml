<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/alta_companero"
                android:textColor="@color/primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nombre"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:autofillHints="name"
                android:backgroundTint="@color/secondary"
                android:hint="@string/nombre_hint"
                android:inputType="textPersonName"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/apellidos"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etApellidos"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="name"
                android:backgroundTint="@color/secondary"
                android:hint="@string/apellidos_hint"
                android:inputType="textPersonName"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sexo"
                android:textColor="@color/primary" />

            <RadioGroup
                android:id="@+id/rgSexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbHombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:text="@string/hombre"
                    android:textColor="@color/primary" />

                <RadioButton
                    android:id="@+id/rbMujer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:buttonTint="@color/primary"
                    android:text="@string/mujer"
                    android:textColor="@color/primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/edad"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etEdad"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:backgroundTint="@color/secondary"
                android:hint="@string/edad_hint"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fecha_entrada"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etFechaEntrada"
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:backgroundTint="@color/secondary"
                android:hint="@string/fecha_entrada_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/introduccion_opcional"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etIntroduccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/secondary"
                android:gravity="top|start"
                android:hint="@string/introduccion_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary" />

            <Button
                android:id="@+id/btnCheck"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primary"
                android:text="@string/guardar_companero"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSiguiente"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/ver_ficha_companeros"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnColeccionTareas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/primary"
                android:text="@string/coleccion_de_tareas"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/buscar_tareas"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnCompra"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/primary"
                android:text="@string/lista_de_la_compra"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnLista"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/lista_de_tareas"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnInvitacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/primary"
                android:text="@string/invitaci_n"
                android:textAllCaps="false"
                android:textColor="@color/surface" />

            <Button
                android:id="@+id/btnCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/enviar_correo"
                android:textAllCaps="false"
                android:textColor="@color/surface" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
