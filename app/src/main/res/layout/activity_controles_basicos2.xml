<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ControlesBasicos2">


    <Button
        android:id="@+id/btn1"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="1"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintEnd_toEndOf="@id/btn4"
        app:layout_constraintStart_toStartOf="@id/btn4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="2"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn1"
        app:layout_constraintEnd_toEndOf="@id/btn5"
        app:layout_constraintStart_toStartOf="@id/btn5"
        app:layout_constraintTop_toTopOf="@id/btn1" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="3"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn1"
        app:layout_constraintEnd_toEndOf="@id/btn6"
        app:layout_constraintStart_toStartOf="@id/btn6"
        app:layout_constraintTop_toTopOf="@id/btn1" />


    <Button
        android:id="@+id/btn4"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="4"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintEnd_toStartOf="@id/btn5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn1" />

    <Button
        android:id="@+id/btn5"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="5"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn4"
        app:layout_constraintEnd_toStartOf="@id/btn6"
        app:layout_constraintStart_toEndOf="@id/btn4"
        app:layout_constraintTop_toTopOf="@id/btn4" />

    <Button
        android:id="@+id/btn6"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="6"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintTop_toTopOf="@id/btn4" />


    <Button
        android:id="@+id/btn7"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="7"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toTopOf="@id/textView"
        app:layout_constraintEnd_toEndOf="@id/btn4"
        app:layout_constraintStart_toStartOf="@id/btn4"
        app:layout_constraintTop_toBottomOf="@id/btn4" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="8"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn7"
        app:layout_constraintEnd_toEndOf="@id/btn5"
        app:layout_constraintStart_toStartOf="@id/btn5"
        app:layout_constraintTop_toTopOf="@id/btn7" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/primary"
        android:text="9"
        android:textColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/btn7"
        app:layout_constraintEnd_toEndOf="@id/btn6"
        app:layout_constraintStart_toStartOf="@id/btn6"
        app:layout_constraintTop_toTopOf="@id/btn7" />


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn8" />

    <EditText
        android:id="@+id/txtAlquiler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:hint="@string/introduce_tu_alquiler_aqu"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <TextView
        android:id="@+id/textViewAlquiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAlquiler" />

    <RadioGroup
        android:id="@+id/radioGroupEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewAlquiler">

        <RadioButton
            android:id="@+id/radioEntero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entero"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/radioCompartido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compartido"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/radioOpcCompra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opción de compra"
            android:textColor="@color/text_primary" />

    </RadioGroup>

    <Button
        android:id="@+id/btnLimpiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Limpiar"
        android:textColor="@color/surface"
        android:backgroundTint="@color/secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radioGroupEstado"/>

</androidx.constraintlayout.widget.ConstraintLayout>

