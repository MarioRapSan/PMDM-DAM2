<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha de un companero: foto, datos y acciones (correo; editar y borrar solo en el perfil propio). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".FichaCompaneroActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarFichaCompanero"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIconTint="@color/on_primary"
        app:title="@string/ficha_companero"
        app:titleTextColor="@color/on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivFotoFicha"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_foto_perfil"
                android:contentDescription="@string/foto_perfil"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_persona" />

            <TextView
                android:id="@+id/tvNombreFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Jose García" />

            <TextView
                android:id="@+id/tvInformacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/surface"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="Sexo: Hombre" />

            <!-- Editar y Borrar solo se muestran en el perfil del propio usuario -->
            <Button
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primary"
                android:text="@string/editar_perfil"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCorreoCompanero"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/enviar_correo"
                android:textAllCaps="false"
                android:textColor="@color/on_primary" />

            <Button
                android:id="@+id/btnBorrarCompanero"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/error"
                android:text="@string/borrar_companero"
                android:textAllCaps="false"
                android:textColor="@color/on_primary" />

            <Button
                android:id="@+id/btnVolverFicha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/volver"
                android:textAllCaps="false"
                android:textColor="@color/on_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
